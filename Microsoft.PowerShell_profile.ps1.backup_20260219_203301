# ROLLBACK RX SNAPSHOT FUNCTIONS
# ============================================
# Functions for managing Rollback Rx Home snapshots via PowerShell
# Supports: snapshot creation, deletion, listing, and status checking

# snapit: Create a new Rollback Rx snapshot
function snapit { & "F:\study\Systems_Virtualization\virtualmachines\VirtualBox\snapit\snapit.ps1" @args }

