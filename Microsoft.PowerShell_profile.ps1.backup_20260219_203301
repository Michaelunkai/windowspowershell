function cfun {
    param(
        [string]$functionName
    )
    if (-not $functionName) { return }
    $content = Get-Content $PROFILE
    $result = @()
    $inFunction = $false
    $braceCount = 0
    $functionStarted = $false
    for ($i = 0; $i -lt $content.Length; $i++) {
        $line = $content[$i]
        if ($line -match "^\s*function\s+$functionName\s*(\{|\(.*\)\s*\{)" -and !$inFunction) {
            $inFunction = $true
            $functionStarted = $true
            $result += $line
            $braceCount += ($line.ToCharArray() | Where-Object { $_ -eq '{' }).Count
            $braceCount -= ($line.ToCharArray() | Where-Object { $_ -eq '}' }).Count
            continue
        }
        if ($inFunction) {
            $result += $line
            $braceCount += ($line.ToCharArray() | Where-Object { $_ -eq '{' }).Count
            $braceCount -= ($line.ToCharArray() | Where-Object { $_ -eq '}' }).Count
            if ($braceCount -le 0) {
                break
            }
        }
    }
    if ($functionStarted) {
        $result
    }
    # Do NOT print anything if not found, to avoid noise
}
# Helper function to check if WSL distribution is running
function Test-WSLDistroRunning {
    param([string]$DistroName)
    try {
        $wslList = wsl -l -v --quiet 2>$null
        if ($wslList) {
            $runningDistros = $wslList | Where-Object { ($_ -match "Running") -and ($_ -match $DistroName) }
            return $runningDistros.Count -gt 0
        }
        return $false
    } catch {
        return $false
    }
}
# Helper function to start WSL distribution in background
function Start-WSLDistro {
    param([string]$DistroName)
    Write-Host "Starting WSL distribution '$DistroName'..." -ForegroundColor Yellow
    try {
        $null = wsl -d $DistroName -u root bash -c "echo 'WSL started' > /dev/null" 2>$null
        Start-Sleep -Milliseconds 500
        if (Test-WSLDistroRunning -DistroName $DistroName) {
            Write-Host "WSL distribution '$DistroName' is now running." -ForegroundColor Green
        } else {
            Write-Warning "WSL distribution '$DistroName' may not have started properly."
        }
    } catch {
        Write-Error "Failed to start WSL distribution '$DistroName': $_"
    }
}
