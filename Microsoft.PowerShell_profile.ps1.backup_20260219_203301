function Get-WSL2Memory {
    Write-Output "Current WSL2 memory usage:" -ForegroundColor Cyan
    wsl -e bash -c "free -h && echo '---' && ps aux --sort=-%mem | head -10"
}
function Reset-WSL2Config {
    $configPath = "$env:USERPROFILE\.wslconfig"
    if (Test-Path $configPath) {
        Remove-Item $configPath -Force
        Write-Output "WSL2 configuration reset. WSL will use default settings." -ForegroundColor Green
        wsl --shutdown
    } else {
        Write-Output "No WSL2 configuration file to reset." -ForegroundColor Yellow
    }
}
# Custom memory allocation function
function Set-WSL2CustomMemory {
    param(
        [Parameter(Mandatory=$true)]
        [int]$MemoryGB,
        [int]$SwapGB,
        [int]$ProcessorCount = 4,
        [string]$Distribution = "Ubuntu"
    )
    if (-not $SwapGB) { $SwapGB = [math]::Max(1, [math]::Floor($MemoryGB / 2)) }
    Set-WSL2Memory -MemoryGB $MemoryGB -SwapGB $SwapGB -Distribution $Distribution
}
