function refresh-disk {
    Write-Host "=== FORCING DISK SPACE REFRESH ===" -ForegroundColor Cyan

    # 1. Force NTFS flush
    Write-Host "Flushing NTFS volume..." -ForegroundColor Yellow
    fsutil volume flush C: 2>$null

    # 2. Flush filesystem buffers
    [System.GC]::Collect()
    [System.GC]::WaitForPendingFinalizers()

    # 3. Notify shell of changes
    Write-Host "Notifying shell..." -ForegroundColor Yellow
    $code = '[DllImport("shell32.dll")] public static extern void SHChangeNotify(int wEventId, int uFlags, IntPtr dwItem1, IntPtr dwItem2);'
    $shell = Add-Type -MemberDefinition $code -Name "Shell32Refresh" -Namespace "Win32Refresh" -PassThru -EA SilentlyContinue
    if ($shell) { $shell::SHChangeNotify(0x8000000, 0, [IntPtr]::Zero, [IntPtr]::Zero) }

    # 4. Restart Explorer
    Write-Host "Restarting Explorer..." -ForegroundColor Yellow
    Stop-Process -Name explorer -Force -EA SilentlyContinue
    Start-Sleep -Milliseconds 500
    Start-Process explorer.exe
    Start-Sleep -Seconds 1

    # 5. Get ACCURATE disk space from fsutil (bypasses WMI caching issues)
    Write-Host ""
    Write-Host "=== DISK SPACE (from fsutil - most accurate) ===" -ForegroundColor Green
    $fsOutput = fsutil volume diskfree C: 2>$null
    $totalBytes = [regex]::Match($fsOutput, "Total bytes\s+:\s+([\d,]+)").Groups[1].Value -replace ",",""
    $freeBytes = [regex]::Match($fsOutput, "Total free bytes\s+:\s+([\d,]+)").Groups[1].Value -replace ",",""
    $usedBytes = [regex]::Match($fsOutput, "Used bytes\s+:\s+([\d,]+)").Groups[1].Value -replace ",",""

    $total = [math]::Round([long]$totalBytes/1GB,1)
    $free = [math]::Round([long]$freeBytes/1GB,1)
    $used = [math]::Round([long]$usedBytes/1GB,1)
    $pct = [math]::Round(([long]$freeBytes/[long]$totalBytes)*100,1)

    Write-Host "C: Total: ${total}GB | Used: ${used}GB | Free: ${free}GB | Free: ${pct}%" -ForegroundColor White

    # Also show Windows API value for comparison
    $di = [System.IO.DriveInfo]::new("C")
    $apiFree = [math]::Round($di.TotalFreeSpace/1GB,1)
    $apiUsed = [math]::Round(($di.TotalSize - $di.TotalFreeSpace)/1GB,1)
    Write-Host "(Windows API reports: Used: ${apiUsed}GB | Free: ${apiFree}GB)" -ForegroundColor DarkGray
}





