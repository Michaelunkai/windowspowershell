# ============================================
# DOCKER DESKTOP RESOURCE MANAGEMENT (HYPER-V)
# Controls DockerDesktopVM Hyper-V resources
# This machine: 31GB RAM, 16 CPUs
# ============================================

function Set-DockerHyperV {
    param([int]$MemMB, [int]$CPUs, [string]$Label, [string]$Color = "Cyan")
    # Ensure Hyper-V VM Management service is running
    $vmms = Get-Service vmms -ErrorAction SilentlyContinue
    if ($vmms -and $vmms.Status -ne 'Running') {
        Write-Host "Starting Hyper-V service..." -ForegroundColor Yellow
        Start-Service vmms -ErrorAction SilentlyContinue
        Start-Sleep -Seconds 2
    }
    $vmName = "DockerDesktopVM"
    $vm = Get-VM -Name $vmName -ErrorAction SilentlyContinue
    if (-not $vm) { Write-Host "ERROR: $vmName not found. Is Docker Desktop installed with Hyper-V backend?" -ForegroundColor Red; return }
    # Align memory to 2MB boundary (Hyper-V requirement)
    $alignedMemMB = [math]::Floor($MemMB / 2) * 2
    $memBytes = [int64]$alignedMemMB * 1MB
    $memStr = if ($alignedMemMB -ge 1024) { "$([math]::Round($alignedMemMB/1024))GB" } else { "${alignedMemMB}MB" }
    Write-Host "$Label : $memStr RAM, $CPUs CPUs" -ForegroundColor $Color
    $wasRunning = $vm.State -eq 'Running'
    if ($wasRunning) {
        Write-Host "Stopping DockerDesktopVM..." -ForegroundColor Yellow
        Stop-VM -Name $vmName -Force -TurnOff -ErrorAction SilentlyContinue
        Start-Sleep -Seconds 2
    }
    try {
        Set-VM -Name $vmName -MemoryStartupBytes $memBytes -ProcessorCount $CPUs -ErrorAction Stop
        Write-Host "Applied: $memStr RAM, $CPUs CPUs" -ForegroundColor Green
    } catch {
        Write-Host "ERROR: $($_.Exception.Message)" -ForegroundColor Red
        if ($wasRunning) { Start-VM -Name $vmName -ErrorAction SilentlyContinue }
        return
    }
    if ($wasRunning) {
        Write-Host "Starting DockerDesktopVM..." -ForegroundColor Yellow
        Start-VM -Name $vmName -ErrorAction SilentlyContinue
        Start-Sleep -Seconds 3
        Write-Host "Docker Desktop VM restarted with new resources" -ForegroundColor Green
    } else {
        Write-Host "VM stopped. Start Docker Desktop to apply." -ForegroundColor Yellow
    }
}

