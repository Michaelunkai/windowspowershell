        # Manual cleanup of installation directories
        $dockerPaths = @(
            "$env:ProgramFiles\Docker",
            "$env:LOCALAPPDATA\Docker",
            "$env:APPDATA\Docker",
            "$env:APPDATA\Docker Desktop"
        )
        foreach ($path in $dockerPaths) {
            if (Test-Path $path) {
                Write-Host "Removing directory: $path" -ForegroundColor Gray
                try {
                    Remove-Item -Path $path -Recurse -Force -ErrorAction SilentlyContinue
                } catch {
                    # Some files might be locked, ignore and continue
                }
            }
        }
        # Clean registry entries (optional but thorough)
        try {
            $registryPaths = @(
                "HKLM:\SOFTWARE\Docker Inc.",
                "HKCU:\SOFTWARE\Docker Inc."
            )
            foreach ($regPath in $registryPaths) {
                if (Test-Path $regPath) {
                    Write-Host "Cleaning registry: $regPath" -ForegroundColor Gray
                    Remove-Item -Path $regPath -Recurse -Force -ErrorAction SilentlyContinue
                }
            }
        } catch {
            # Registry cleanup is optional
        }
        # Step 4: Install Docker Desktop with retries
        Write-Host "Installing Docker Desktop..." -ForegroundColor Yellow
        $installSuccess = $false
        $retryCount = 0
        while (-not $installSuccess -and $retryCount -lt $MaxRetries) {
            $retryCount++
            Write-Host "Installation attempt $retryCount of $MaxRetries" -ForegroundColor Cyan
            try {
                # Use winget to install
                $installResult = & winget install -e --id Docker.DockerDesktop --silent --force --accept-package-agreements --accept-source-agreements --disable-interactivity 2>&1
                # Check if installation was successful
                Start-Sleep -Seconds 5
                if (Test-Path "$env:ProgramFiles\Docker\Docker\Docker Desktop.exe") {
                    $installSuccess = $true
                    Write-Host "Docker Desktop installation successful!" -ForegroundColor Green
                } else {
                    Write-Host "Installation attempt $retryCount failed, retrying..." -ForegroundColor Red
                    Start-Sleep -Seconds 10
                }
            } catch {
                Write-Host "Installation attempt $retryCount failed with error: $($_.Exception.Message)" -ForegroundColor Red
                Start-Sleep -Seconds 10
            }
        }
        if (-not $installSuccess) {
            throw "Failed to install Docker Desktop after $MaxRetries attempts"
        }
        # Step 5: Start Docker Desktop
        Write-Host "Starting Docker Desktop..." -ForegroundColor Yellow
        $dockerExePath = "$env:ProgramFiles\Docker\Docker\Docker Desktop.exe"
        if (Test-Path $dockerExePath) {
            # Start Docker Desktop
            Start-Process -FilePath $dockerExePath -WindowStyle Hidden
            # Wait for Docker to initialize
            Write-Host "Waiting for Docker Desktop to initialize (${StartupWaitTime}s)..." -ForegroundColor Yellow
            Start-Sleep -Seconds $StartupWaitTime
            # Step 6: Verify Docker is running
            Write-Host "Verifying Docker installation..." -ForegroundColor Yellow
            $verificationSuccess = $false
            $verifyRetries = 0
            while (-not $verificationSuccess -and $verifyRetries -lt 6) {
                $verifyRetries++
                try {
                    # Try to run docker version command
                    $dockerVersion = & docker version --format json 2>$null
                    if ($LASTEXITCODE -eq 0) {
                        $verificationSuccess = $true
                        Write-Host "Docker verification successful!" -ForegroundColor Green
                        # Parse and display version info
                        $versionInfo = $dockerVersion | ConvertFrom-Json
                        Write-Host "Docker Engine Version: $($versionInfo.Server.Version)" -ForegroundColor Cyan
                        Write-Host "Docker Desktop is ready!" -ForegroundColor Green
                    } else {
                        Write-Host "Docker not ready yet, waiting..." -ForegroundColor Yellow
                        Start-Sleep -Seconds 10
                    }
                } catch {
                    Write-Host "Docker verification attempt $verifyRetries failed, retrying..." -ForegroundColor Orange
                    Start-Sleep -Seconds 10
                }
            }
            if (-not $verificationSuccess) {
                Write-Host "Warning: Docker Desktop installed but verification failed. It may need more time to start." -ForegroundColor Orange
            }
        } else {
            throw "Docker Desktop executable not found after installation"
        }
        Write-Host "Docker Desktop reinstallation completed successfully!" -ForegroundColor Green
        return $true
    } catch {
        Write-Host "Error during Docker Desktop reinstallation: $($_.Exception.Message)" -ForegroundColor Red
        return $false
    }
}
