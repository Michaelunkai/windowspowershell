# ========== POWERSHELL 5 && and || OPERATORS - NATIVE SYNTAX ==========
# Make PowerShell 5 support && and || DIRECTLY without wrapper
# Intercepts commands at PSReadLine level BEFORE parser sees them

function Invoke-ChainedCommand {
    param([string]$CommandString)
    
    # Split by && and || while preserving the operators
    $pattern = '(\s*&&\s*|\s*\|\|\s*)'
    $parts = $CommandString -split $pattern | Where-Object { $_ -and $_.Trim() }
    
    $lastExitCode = 0
    $i = 0
    
    while ($i -lt $parts.Count) {
        $part = $parts[$i].Trim()
        
        # Check if this is an operator
        if ($part -match '^(&&|\|\|)$') {
            $operator = $Matches[1]
            $i++
            if ($i -ge $parts.Count) { break }
            $nextCommand = $parts[$i].Trim()
            
            # && = execute next only if previous succeeded (exit code 0)
            if ($operator -eq '&&' -and $lastExitCode -ne 0) {
                # Skip this command
                $i++
                continue
            }
            
            # || = execute next only if previous failed (exit code non-zero)
            if ($operator -eq '||' -and $lastExitCode -eq 0) {
                # Skip this command
                $i++
                continue
            }
            
            # Execute the next command
            try {
                Invoke-Expression $nextCommand
                $lastExitCode = $LASTEXITCODE
                if ($null -eq $lastExitCode) { $lastExitCode = 0 }
            } catch {
                $lastExitCode = 1
            }
        } else {
            # This is a command, execute it
            try {
                Invoke-Expression $part
                $lastExitCode = $LASTEXITCODE
                if ($null -eq $lastExitCode) { $lastExitCode = 0 }
            } catch {
                $lastExitCode = 1
            }
        }
        
        $i++
    }
    
    return $lastExitCode
}

# PSReadLine key handler to intercept Enter and preprocess && and ||
Set-PSReadLineKeyHandler -Key Enter -ScriptBlock {
    param($key, $arg)
    
    $line = $null
    $cursor = $null
    [Microsoft.PowerShell.PSConsoleReadLine]::GetBufferState([ref]$line, [ref]$cursor)
    
    # Check if line contains && or ||
    if ($line -match '&&|\|\|') {
        # Clear the current line
        [Microsoft.PowerShell.PSConsoleReadLine]::RevertLine()
        [Microsoft.PowerShell.PSConsoleReadLine]::AcceptLine()
        
        # Execute via our chain handler
        Invoke-ChainedCommand $line
    } else {
        # Normal execution
        [Microsoft.PowerShell.PSConsoleReadLine]::AcceptLine()
    }
}

