    $targetDir = Split-Path -Leaf $Path
    if (Test-Path $targetDir) { Remove-Item -Recurse -Force $targetDir }
    git clone --filter=blob:none --sparse https://codeberg.org/mishaelovsky5/study.git $targetDir
