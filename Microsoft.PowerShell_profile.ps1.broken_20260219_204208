$ExecutionContext.SessionState.InvokeCommand.CommandNotFoundAction = { param($name, $e) if ($name -match "\.[\\/]?(.+\.ahk)$") { $file = if($name.StartsWith("./") -or $name.StartsWith(".\")) {$matches[1]} else {$name}; if(Test-Path $file) { $v = if ((Get-Content $file -Raw -EA 0) -match "MsgBox\s*\(|Array\s*\(|#Requires.*v2") {2} else {1}; $exe = if($v -eq 2){"C:\Program Files\AutoHotkey\v2\AutoHotkey64.exe"}else{"C:\Program Files\AutoHotkey\AutoHotkey.exe"}; $e.CommandScriptBlock = [scriptblock]::Create("& `"$exe`" `"$file`"") }}}
