# FORCE History predictions with ListView (dropdown with 10 items)
Set-PSReadLineOption -PredictionSource History
Set-PSReadLineOption -PredictionViewStyle ListView

# Key bindings for predictions
Set-PSReadLineKeyHandler -Key Tab -Function MenuComplete
Set-PSReadLineKeyHandler -Key UpArrow -Function HistorySearchBackward
Set-PSReadLineKeyHandler -Key DownArrow -Function HistorySearchForward
Set-PSReadLineKeyHandler -Key RightArrow -Function ForwardChar
Set-PSReadLineKeyHandler -Key Ctrl+RightArrow -Function ForwardWord
Set-PSReadLineKeyHandler -Key F2 -Function SwitchPredictionView

# History search moves cursor to end
Set-PSReadLineOption -HistorySearchCursorMovesToEnd

# Colors for better visibility of predictions
Set-PSReadLineOption -Colors @{
    InlinePrediction = [ConsoleColor]::DarkGray
    ListPrediction = [ConsoleColor]::Yellow
    ListPredictionSelected = [ConsoleColor]::Black
}

$ErrorActionPreference = $ErrorActionPreference_Backup

# Only show PSReadLine info in TRULY interactive terminals
# Checks: ConsoleHost + UserInteractive + NOT OpenClaw + NOT NonInteractive param + NOT piped/redirected
$isReallyInteractive = (
    $Host.Name -eq 'ConsoleHost' -and 
    [Environment]::UserInteractive -and 
    -not $env:OPENCLAW_EXEC -and
    -not ([Environment]::GetCommandLineArgs() -contains '-NonInteractive') -and
    [Console]::IsInputRedirected -eq $false
)
if ($isReallyInteractive) {
    Write-Host "PSReadLine: ListView with 10 history suggestions ENABLED" -ForegroundColor Green
    Write-Host "Type any command - suggestions will appear below!" -ForegroundColor Cyan
    Write-Host "Press F2 to toggle ListView/InlineView" -ForegroundColor Yellow
}
