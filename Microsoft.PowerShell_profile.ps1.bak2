# PERMANENT Node.js RAM Configuration Functions
# All functions set PERMANENT User-level environment variables that persist across ALL sessions

# 1GB RAM - Permanent


# 2GB RAM - Permanent


# 4GB RAM - Permanent


# 5GB RAM - Permanent


# 6GB RAM - Permanent


# 8GB RAM - Permanent


# PERMANENT Node.js Context/Header Size Configuration Functions
# PowerShell 5.1+ Compatible - All functions set PERMANENT environment variables

# 4KB Context - Permanent (tiny)


# 8KB Context - Permanent (minimal/default)


# 16KB Context - Permanent (small)


# 32KB Context - Permanent (medium)


# 64KB Context - Permanent (large)


# 128KB Context - Permanent (huge)


# 256KB Context - Permanent (massive)
function nodecontext256kb {
    [System.Environment]::SetEnvironmentVariable('NODE_OPTIONS', '--max-old-space-size=8192 --max-http-header-size=262144 --expose-gc --no-warnings', 'User')
    [System.Environment]::SetEnvironmentVariable('CLAUDE_CODE_MAX_MEMORY', '8192', 'User')
    [System.Environment]::SetEnvironmentVariable('CLAUDE_CODE_TIMEOUT', '0', 'User')
    [System.Environment]::SetEnvironmentVariable('CLAUDE_CODE_RETRY', 'true', 'User')
    [System.Environment]::SetEnvironmentVariable('UV_THREADPOOL_SIZE', '128', 'User')
    [System.Environment]::SetEnvironmentVariable('UV_USE_IO_URING', '0', 'User')
    refreshenv
    Write-Host "Permanent 256KB context size applied for ALL future sessions!" -ForegroundColor Green
    Write-Host "NODE_OPTIONS: $env:NODE_OPTIONS" -ForegroundColor Cyan
    Write-Host "Restart ALL terminals to see changes everywhere" -ForegroundColor Yellow
}

# 512KB Context - Permanent (extreme)


# 1MB Context - Permanent (maximum)
function nodecontext1mb {
    [System.Environment]::SetEnvironmentVariable('NODE_OPTIONS', '--max-old-space-size=8192 --max-http-header-size=1048576 --expose-gc --no-warnings', 'User')
    [System.Environment]::SetEnvironmentVariable('CLAUDE_CODE_MAX_MEMORY', '8192', 'User')
    [System.Environment]::SetEnvironmentVariable('CLAUDE_CODE_TIMEOUT', '0', 'User')
