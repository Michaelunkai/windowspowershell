# Helper function to test all configurations
function test-all-docker-configs {
    $functions = Get-ChildItem function:docker* | Where-Object Name -like "docker*-*"
    
    foreach ($func in $functions) {
        Write-Host "Testing $($func.Name)..." -ForegroundColor Cyan
        & $func.Name
        Write-Host "Press any key to continue to next config..." -ForegroundColor Yellow
        $null = $host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
    }
    
    Write-Host "All docker configurations tested!" -ForegroundColor Green
}

# Reset WSL to default configuration
function reset-wsl-config {
    wsl -d ubuntu --user root -- bash -c "rm -f /mnt/c/Users/micha/.wslconfig && echo 'Removed WSL2 config file - returned to default settings'"
    wsl --shutdown
    Write-Host "WSL2 configuration reset to defaults" -ForegroundColor Green
}

