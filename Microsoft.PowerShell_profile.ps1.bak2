}





function megaclean { $ErrorActionPreference='SilentlyContinue'; $script:n=0; $script:total=200; $start=Get-Date; $startFree=[math]::Round(((Get-WmiObject Win32_LogicalDisk -Filter "DeviceID='C:'" -EA 0).FreeSpace/1GB),2); function run($t,$name,$c){$script:n++; Write-Host "[$script:n/$script:total] " -NoNewline -ForegroundColor Cyan; Write-Host "$name " -NoNewline -ForegroundColor Yellow; Write-Host "(${t}s)" -NoNewline -ForegroundColor DarkGray; $j=Start-Job -ScriptBlock $c; $done=Wait-Job $j -Timeout $t; if($done){Write-Host " OK" -ForegroundColor Green}else{Stop-Job $j; Write-Host " SKIP" -ForegroundColor Red}; Remove-Job $j -Force}; Write-Host "`n=== MEGACLEAN 4X STARTED ===" -ForegroundColor Magenta; Write-Host "C: Free before: ${startFree}GB" -ForegroundColor Gray; Write-Host "`n[PHASE 1/12] WINDOWS TEMP" -ForegroundColor White; run 30 "win-temp" {Remove-Item "C:\Windows\Temp\*" -Recurse -Force -EA 0}; run 30 "win-temp2" {Remove-Item "C:\Temp\*" -Recurse -Force -EA 0}; run 30 "win-systemtemp" {Remove-Item "C:\Windows\SystemTemp\*" -Recurse -Force -EA 0}; run 30 "win-cbstemp" {Remove-Item "C:\Windows\CbsTemp\*" -Recurse -Force -EA 0}; run 30 "serviceprofile-local" {Remove-Item "C:\Windows\ServiceProfiles\LocalService\AppData\Local\Temp\*" -Recurse -Force -EA 0}; run 30 "serviceprofile-network" {Remove-Item "C:\Windows\ServiceProfiles\NetworkService\AppData\Local\Temp\*" -Recurse -Force -EA 0}; run 30 "serviceprofile-fontcache" {Remove-Item "C:\Windows\ServiceProfiles\LocalService\AppData\Local\FontCache\*" -Recurse -Force -EA 0}; Write-Host "`n[PHASE 2/12] WINDOWS LOGS" -ForegroundColor White; run 30 "win-logs" {Remove-Item "C:\Windows\Logs\*" -Recurse -Force -EA 0}; run 30 "win-cbs" {Remove-Item "C:\Windows\Logs\CBS\*" -Recurse -Force -EA 0}; run 30 "win-dism" {Remove-Item "C:\Windows\Logs\DISM\*" -Recurse -Force -EA 0}; run 30 "win-dpx" {Remove-Item "C:\Windows\Logs\DPX\*" -Recurse -Force -EA 0}; run 30 "win-mosetup" {Remove-Item "C:\Windows\Logs\MoSetup\*" -R