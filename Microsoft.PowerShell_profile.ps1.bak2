$ExecutionContext.SessionState.InvokeCommand.CommandNotFoundAction = { param($name, $e) if ($name -match "\.ahk$") { $v = if ((Get-Content $name -Raw -EA 0) -match "MsgBox\(|Array\(|#Requires.*v2") {2} else {1}; $exe = @{1="C:\Program Files\AutoHotkey\AutoHotkey.exe"; 2="C:\Program Files\AutoHotkey\v2\AutoHotkey64.exe"}[$v]; $e.CommandScriptBlock = [scriptblock]::Create("& `"$exe`" `"$name`"") }}
